#!/bin/zsh
# ContextEngine — Pre-commit CE Compliance Check + Secret Scanner
#
# BLOCKS commits when:
#   1. Staged files contain hardcoded passwords/API keys/secrets
#   2. Code files changed but CE docs are stale or missing
#
# Agents ignore warnings — only hard blocks prevent compliance drift.
#
# Install: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

# Ensure standard tools are on PATH (git hooks run with minimal PATH)
export PATH="/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:$PATH"

# ===================================================================
# Helper: locate the ContextEngine CLI
# ===================================================================
# Order: project-local node_modules → global which → none (skip policy).
# We intentionally do NOT fall back to `npx @compr/contextengine-mcp` —
# cold npx is ~2-3s on every commit; too painful for a hot path. Teams
# that want policy-driven gates should install CE in node_modules or
# globally.
find_ce_cli() {
  if [[ -x "node_modules/.bin/contextengine" ]]; then
    echo "node_modules/.bin/contextengine"
    return 0
  fi
  if command -v contextengine >/dev/null 2>&1; then
    command -v contextengine
    return 0
  fi
  echo ""
}

CE_CLI=$(find_ce_cli)
HAS_POLICY=false
[[ -f .contextengine/policy.json ]] && HAS_POLICY=true

# ===================================================================
# PHASE 0: Secret Scanner — three complementary layers
# ===================================================================
#   1. gitleaks (if installed) — industry-standard ~150-pattern ruleset.
#      Audited, maintained. Install: brew install gitleaks
#   2. CE policy-driven scan (if CLI + policy.json present) — applies
#      .contextengine/policy.json secret_patterns with paths-glob scoping
#      and severity (block | warn). Project-specific shapes that gitleaks
#      doesn't know (e.g. jwt_in_session_doc scoped to docs/sessions/**).
#   3. CE inline patterns (always) — 17 in-house regexes covering
#      Stripe/GitHub/AWS/Slack/etc + project-specific DB-password shapes
#      + the .copilot-credentials.md staging guard. Defense in depth:
#      catches whatever the first two layers missed.
#
# Each layer can block independently. First one to fail wins; later
# layers do not run.

# Layer 1: gitleaks
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS_OUTPUT=$(gitleaks protect --staged --redact --no-banner --verbose 2>&1)
  GITLEAKS_EXIT=$?
  if [[ $GITLEAKS_EXIT -ne 0 ]]; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════╗"
    echo "║  🔒 GITLEAKS: secret(s) detected                          ║"
    echo "╠═══════════════════════════════════════════════════════════╣"
    echo "$GITLEAKS_OUTPUT" | head -25
    echo "║  Secrets belong in .env or .copilot-credentials.md       ║"
    echo "║  ❌ COMMIT BLOCKED — remove secrets first                 ║"
    echo "╚═══════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi
fi

# Layer 2: CE policy-driven scan (added 2026-06 — P1 #4 part 3)
# The CLI exits 0 cleanly when no policy file exists, so the HAS_POLICY
# gate is a perf optimization, not a correctness requirement.
if [[ -n "$CE_CLI" && "$HAS_POLICY" == "true" ]]; then
  if ! "$CE_CLI" hook secret-scan; then
    # CLI already printed the violation list + wrote hook.block to audit log
    exit 1
  fi
fi

# Layer 3: CE inline patterns (always)
SECRET_PATTERNS=(
  'sshpass -p [^*"$]:::Hardcoded sshpass password (use SSHPASS env var)'
  'whsec_[A-Za-z0-9]{20,}:::Stripe webhook secret (use .env)'
  'sk_live_[A-Za-z0-9]{20,}:::Stripe live secret key (use .env)'
  'sk_test_[A-Za-z0-9]{20,}:::Stripe test secret key (use .env)'
  'AIzaSy[A-Za-z0-9_-]{30,}:::Google API key (use .env)'
  'gsk_[A-Za-z0-9]{20,}:::Groq API key (use .env)'
  'ghp_[A-Za-z0-9]{36,}:::GitHub personal access token (use .env)'
  'glpat-[A-Za-z0-9_-]{20,}:::GitLab personal access token (use .env)'
  'xoxb-[0-9]{10,}:::Slack bot token (use .env)'
  'xoxp-[0-9]{10,}:::Slack user token (use .env)'
  'AKIA[A-Z0-9]{16}:::AWS access key ID (use .env)'
  'pk_live_[A-Za-z0-9]{20,}:::Stripe publishable live key (use .env)'
  'SG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}:::SendGrid API key (use .env)'
  'Cr0wlr_Pr0d_[A-Za-z0-9!@#$%^&*_]+:::Production DB password (use .copilot-credentials.md)'
  'C0ldEm@il_[A-Za-z0-9!@#$%^&*_]+:::COLDemail DB password (use .copilot-credentials.md)'
  # [LOCKED] [PASSWORD-PATTERNS-ARE-VALUE-INDEPENDENT] - 2026-08-20
  # [NEVER] reduce these to a single 'password.*=' shape, and [NEVER] require 8
  #         contiguous value characters.
  # WHY: the previous pattern was `password.*=.*[chars]{8,}`. Run against a fixture bench
  #      (scripts/test-secret-scan.sh) it missed 6 of 8 lines it should block, including
  #      `PASSWORD = "abc" + chr(33) + "def"`, the exact line that walked a live sudo
  #      password through this gate in agent.invoq.me.ai ccf97fa: the `+ chr(33) +`
  #      breaks the 8-contiguous-character run. It also missed every colon form
  #      (YAML, JSON, docs) and every markdown table cell, and it BLOCKED
  #      `password = os.environ["DB_PASSWORD"]`, which is the correct practice.
  # FIX: three value-independent shapes, a quoted-value form, and an allowlist for the
  #      placeholder conventions that docs legitimately use. Change any of them only
  #      together with the fixtures, and only when scripts/test-secret-scan.sh passes.
  '(^|[^a-z])[a-z_]*(password|passwd|pwd|pass|secret)\s*[:=]\s*['"'"'"][^'"'"'"]{3,}['"'"'"]:::Hardcoded password (quoted value)'
  '(^|[^a-z])[a-z_]*(password|passwd|pwd|pass|secret)\s*[:=]\s*[^[:space:]'"'"'"<$({\[][^[:space:](.\[]{4,}([[:space:]]|$|[,;]):::Hardcoded password (bare value)'
  '["'"'"']?password[a-z_]*["'"'"']?\s*:\s*["'"'"'][^"'"'"']{6,}["'"'"']:::Hardcoded password (JSON/YAML key)'
  '\|\s*password\s*\|\s*`?[^|<[:space:]`][^|]*\|:::Hardcoded password (markdown table cell)'
)

# [LOCKED] [NO-HEX-ESCAPES-IN-ANY-PATTERN] - 2026-08-21
# [NEVER] write \x27, \x22 or any \xNN escape in SECRET_PATTERNS or SECRET_ALLOWLIST.
#         Use a literal character, and close/reopen the single quote for an apostrophe.
# WHY: grep -E does not interpret \xNN. Under zsh the escape happened to match, under
#      bash it silently matched nothing, so a pattern could pass the bench on one shell
#      and be dead on the other. This bug was fixed once on 2026-08-20 in the value
#      patterns, then REINTRODUCED the same day in this allowlist, and the bench stayed
#      green because it only exercised double quotes. A fix that is not locked is a fix
#      that comes back.
# FIX: scripts/test-secret-scan.sh now runs under both shells and requires agreement,
#      and it fails if a \x escape appears anywhere in the hook.
# Lines matching this are never reported, whatever the patterns say. Keep it to
# placeholder conventions, never to specific values.
SECRET_ALLOWLIST='(<see [^>]+>|<hidden>|<redacted>|<your[^>]*>|<placeholder>|\$\{[A-Z_]+\}|os\.environ|process\.env|getenv\(|see credentials|see \.copilot-credentials|[:=][[:space:]]*['"'"'"]?(\.\.\.+|\*{3,}|x{3,}|REDACTED|CHANGEME|changeme|xxx+)['"'"'"]?)'

# [LOCKED] [A-STAGED-ENV-FILE-IS-A-VIOLATION-NOT-AN-EXEMPTION] - 2026-08-21
# [NEVER] put .env, .env.local or the credentials file back in this skip list.
# WHY: this list used to exempt '\.env$', meaning ANY path ending in .env: production.env,
#      docker.env, config.env were never scanned. Found by planting DB_PASSWORD=... in a
#      file named a.env and watching it commit. The original intent was "the .env file
#      is gitignored, skip it", but a file that is STAGED is by definition not ignored,
#      so the one case where .env reaches this scanner is exactly the case it must catch.
#      No tracked *.env exists in any of the 26 repos today; this keeps it that way.
#      The credentials file has its own hard block further down (staged = refused), so
#      exempting it from content scanning was redundant at best.
# FIX: exempt only the fixture bench (synthetic secrets by design) and this hook's own
#      source. .env.example is still scanned: if it holds a real value, that is a leak.
SKIP_FILES='(pre-commit$|tests/fixtures/secret-scan/)'
STAGED_DIFF=$(git diff --cached --diff-filter=ACMR -U0 2>/dev/null)
STAGED_FILE_LIST=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)

SECRET_VIOLATIONS=0
SECRET_DETAILS=""

if [[ -n "$STAGED_DIFF" ]]; then
  FILTERED_DIFF=""
  CURRENT_FILE=""
  SKIP_CURRENT=false

  while IFS= read -r line; do
    if [[ "$line" =~ ^diff\ --git ]]; then
      CURRENT_FILE=$(echo "$line" | sed 's|.*b/||')
      if echo "$CURRENT_FILE" | grep -qE "$SKIP_FILES"; then
        SKIP_CURRENT=true
      else
        SKIP_CURRENT=false
      fi
    fi
    if [[ "$SKIP_CURRENT" == false ]]; then
      FILTERED_DIFF+="$line"$'\n'
    fi
  done <<< "$STAGED_DIFF"

  for entry in "${SECRET_PATTERNS[@]}"; do
    PATTERN="${entry%%:::*}"
    DESCRIPTION="${entry##*:::}"
    # [LOCKED] [SECRET_SCAN_CASE_INSENSITIVE] - 2026-08-20
    # [NEVER] drop the -i on this grep.
    # WHY: case-sensitive, the generic 'password.*=' pattern let
    #      `PASSWORD = "..." + chr(33) + "..."` (a live sudo password) through the gate in
    #      agent.invoq.me.ai ccf97fa. Tested against that exact line: -E missed, -iE caught.
    #      The gap was deployed identically in 25 repos.
    # FIX: -iE. Every pattern in SECRET_PATTERNS is either a fixed prefix (sk_live_, AKIA,
    #      ghp_) where case does not matter, or a word (password) where it must not.
    # [LOCKED] [ADDED-LINE-FILTER-DROPS-ONLY-THE-FILE-HEADER] - 2026-08-21
    # [NEVER] go back to '^\+[^+]' here.
    # WHY: that shape drops any added line whose content starts with '+', not just the
    #      '+++ b/path' header. A line reading  +password = "..."  (a diff pasted into a
    #      doc, a patch file, a string starting with +) walked straight through. Found by
    #      planting exactly that line.
    # FIX: keep every added line, then remove the one header git emits as '+++ '.
    MATCHES=$(echo "$FILTERED_DIFF" | grep -E '^\+' | grep -vE '^\+\+\+ ' | grep -iE "$PATTERN" 2>/dev/null | grep -viE "$SECRET_ALLOWLIST" 2>/dev/null)
    if [[ -n "$MATCHES" ]]; then
      ((SECRET_VIOLATIONS++))
      SECRET_DETAILS+="  🔑 $DESCRIPTION\n"
    fi
  done
fi

if echo "$STAGED_FILE_LIST" | grep -q '\.copilot-credentials\.md'; then
  ((SECRET_VIOLATIONS++))
  SECRET_DETAILS+="  🚫 .copilot-credentials.md is staged! Run: git reset HEAD .copilot-credentials.md\n"
fi

if [[ $SECRET_VIOLATIONS -gt 0 ]]; then
  echo ""
  echo "╔═══════════════════════════════════════════════════════════╗"
  echo "║  🔒 SECRET SCANNER: $SECRET_VIOLATIONS violation(s) found                    ║"
  echo "╠═══════════════════════════════════════════════════════════╣"
  echo -e "$SECRET_DETAILS"
  echo "║  Secrets belong in .env or .copilot-credentials.md       ║"
  echo "║  ❌ COMMIT BLOCKED — remove secrets first                 ║"
  echo "╚═══════════════════════════════════════════════════════════╝"
  echo ""
  exit 1
fi

# ===================================================================
# PHASE 0b: .claude/settings.json hygiene
# ===================================================================
# Ported from PLANK.io's hook 2026-08-21 so the common hook can replace it without
# losing the gate. Claude Code appends the LITERAL command it just ran when a
# permission is granted persistently, so that file accumulates rules that can never
# match again: scratchpad paths with a session UUID, npx calls with a 500-char argument
# baked in. It hit 30 entries in one session and refilled within minutes of a hand clean.
#
# [LOCKED] [SETTINGS-GATE-IS-OPT-IN-PER-REPO] - 2026-08-21
# [NEVER] make this gate unconditional.
# WHY: it delegates to scripts/prune_claude_settings.sh, which exists in 2 of the 26
#      repos carrying this hook. Unconditional, it would fail every settings.json
#      commit in the other 24 with "file not found", which reads as a hygiene
#      violation and is not one.
# FIX: the gate is live exactly where the script is present. A repo opts in by adding
#      the script. Placed before the code-file gate because settings.json is not a
#      CODE_EXT, so a later check would never run on the commit that adds the junk.
if [[ -x scripts/prune_claude_settings.sh ]] && \
   git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -qx '.claude/settings.json'; then
  if ! PRUNE_OUT=$(bash scripts/prune_claude_settings.sh 2>&1); then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════╗"
    echo "║  🧹 .claude/settings.json has one-off permission rules    ║"
    echo "╠═══════════════════════════════════════════════════════════╣"
    echo "$PRUNE_OUT"
    echo "║  ❌ COMMIT BLOCKED — prune, re-stage, commit              ║"
    echo "╚═══════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi
fi

# ===================================================================
# PHASE 1: Doc Freshness
# ===================================================================
# Two paths:
#   - Policy-driven (preferred): when policy.json is present, the
#     diff-aware doc_coverage rules ARE the source of truth. The
#     legacy 4h wall-clock check is suppressed — it was the workaround
#     pattern (touching SKILLS.md to reset the clock).
#   - Legacy fallback: when no policy is authored, the original 4h
#     wall-clock check on copilot-instructions.md / SKILLS.md / SCORE.md
#     runs unchanged. Repos without a policy keep working exactly as
#     before. Migration is opt-in by adding .contextengine/policy.json.

if [[ -n "$CE_CLI" && "$HAS_POLICY" == "true" ]]; then
  if ! "$CE_CLI" hook doc-coverage; then
    # CLI already printed violations + wrote hook.block to audit log
    exit 1
  fi

  # rule_parity — a rule present in one agent doc must be present in all of
  # them. Fires only when this commit stages one of the governed docs, so it
  # never blocks unrelated work. Added 2026-08-19: the checker shipped in
  # a7deda8 but nothing invoked it, which is a gate that exists and does
  # nothing — the same "built and disconnected" failure as the delta pipeline
  # (SESSION_20 section J). Run `contextengine hook rule-parity --all` for a
  # whole-repo audit in CI.
  if ! "$CE_CLI" hook rule-parity; then
    exit 1
  fi

  # NOTE: commit_message_required runs from the commit-msg hook
  # (hooks/commit-msg, mirrored to .git/hooks/commit-msg) — NOT here.
  # Verifier P0 fix (2026-06-26): pre-commit fires BEFORE git writes the
  # commit message to .git/COMMIT_EDITMSG, so reading it at this point
  # either returns "" (first commit → false positive) or the PREVIOUS
  # commit's message (subsequent commits → false positive AND false
  # negative AND wrong message in the audit log). The check now runs
  # from commit-msg, which receives the message file path as $1.

  # Policy path is authoritative. Skip the legacy check.
  exit 0
fi

# Legacy path: 4-hour wall-clock check (only when no policy authored).
# This logic is being retired — author .contextengine/policy.json to
# replace it with diff-aware coverage.

CODE_EXTS="ts|tsx|js|jsx|py|rs|go|java|rb|php|vue|svelte|css|scss|html"
STAGED_CODE=$(git diff --cached --name-only | grep -E "\.($CODE_EXTS)$" | head -1)

# If no code files staged, skip all checks (docs-only commit is fine)
if [[ -z "$STAGED_CODE" ]]; then
  exit 0
fi

WARNINGS=0
NOW=$(date +%s)
STALE_HOURS=4

warn() {
  echo "⚠️  CE: $1"
  ((WARNINGS++))
}

check_freshness() {
  local file="$1"
  local label="$2"

  local found_paths=()
  for candidate_path in "$file" ".github/$file" ".github/instructions/$file"; do
    if [[ -f "$candidate_path" ]]; then
      found_paths+=("$candidate_path")
    fi
  done

  if [[ ${#found_paths[@]} -eq 0 ]]; then
    warn "$label — NOT FOUND (create it!)"
    return
  fi

  for fp in "${found_paths[@]}"; do
    if git diff --cached --name-only | grep -q "$fp"; then
      return
    fi
  done

  local newest_mtime=0
  for fp in "${found_paths[@]}"; do
    local mtime=$(stat -f %m "$fp" 2>/dev/null || stat -c %Y "$fp" 2>/dev/null)
    if [[ -n "$mtime" && $mtime -gt $newest_mtime ]]; then
      newest_mtime=$mtime
    fi
  done

  if [[ $newest_mtime -gt 0 ]]; then
    local age_hours=$(( (NOW - newest_mtime) / 3600 ))
    if [[ $age_hours -gt $STALE_HOURS ]]; then
      warn "$label — last updated ${age_hours}h ago (not in this commit)"
    fi
  fi
}

check_freshness "copilot-instructions.md" "copilot-instructions.md"
check_freshness "SKILLS.md" "SKILLS.md"
check_freshness "SCORE.md" "SCORE.md"

LEARNINGS_FILE="$HOME/.contextengine/learnings.json"
if [[ -f "$LEARNINGS_FILE" ]]; then
  LEARN_MTIME=$(stat -f %m "$LEARNINGS_FILE" 2>/dev/null || stat -c %Y "$LEARNINGS_FILE" 2>/dev/null)
  if [[ -n "$LEARN_MTIME" ]]; then
    LEARN_AGE=$(( (NOW - LEARN_MTIME) / 3600 ))
    if [[ $LEARN_AGE -gt 8 ]]; then
      warn "No learnings saved in ${LEARN_AGE}h — did you forget save_learning?"
    fi
  fi
fi

if [[ $WARNINGS -gt 0 ]]; then
  echo ""
  echo "╔═══════════════════════════════════════════════════════╗"
  echo "║  ContextEngine: $WARNINGS CE compliance violation(s)          ║"
  echo "║  Code changed but CE docs are stale or missing.      ║"
  echo "║  Update: copilot-instructions, SKILLS, SCORE         ║"
  echo "║                                                       ║"
  echo "║  ❌ COMMIT BLOCKED — update docs first                ║"
  echo "║  💡 Author .contextengine/policy.json for diff-aware  ║"
  echo "║     coverage instead of wall-clock staleness.        ║"
  echo "╚═══════════════════════════════════════════════════════╝"
  echo ""
  exit 1
fi

exit 0
